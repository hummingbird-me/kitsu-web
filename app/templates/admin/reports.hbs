<div class="container user-reports">
  <h3 class="headline" data-test-pending-reports-title>Reports</h3>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Explanation</th>
        <th>N Status</th>
        <th>Explanation</th>
        <th>Type</th>
        <th>Target</th>
        <th>Reporter</th>
      </tr>
    </thead>
    <tbody>
      {{#each model as |report|}}
        {{admin/report-item report=report}}
      {{/each}}
      {{admin/report-item report=model.firstObject}}
    </tbody>
  </table>
</div>
